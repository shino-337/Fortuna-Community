# =============================================================================
# Fortuna Production – Config (copy to config.env and adjust)
# =============================================================================

# Image version tag (required for production; avoid 'latest')
VERSION=v1.0.0

# Container registry (leave empty to build locally only)
# Example: registry.company.com/fortuna
REGISTRY=

# Kubernetes namespace
NAMESPACE=fortuna

# Containerd namespace for nerdctl (usually k8s.io when K8s uses containerd)
CONTAINERD_NAMESPACE=k8s.io

# Skip build steps (0 = run, 1 = skip)
SKIP_BUILD_CORE=0
SKIP_BUILD_AGENT=0
SKIP_BUILD_DASHBOARD=0

# Push images to REGISTRY after build (0 = no, 1 = yes)
PUSH_IMAGES=0

# Log directory for script output (relative to script-prod or absolute)
LOG_DIR=./logs

# Optional: path to project root (auto-detected if not set)
# PROJECT_ROOT=/path/to/KSAM
