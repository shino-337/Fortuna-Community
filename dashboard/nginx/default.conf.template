# nginx config template for the dashboard image. The official nginx entrypoint
# renders it to /etc/nginx/conf.d/default.conf at start-up, substituting only
# the variables matched by NGINX_ENVSUBST_FILTER (see dashboard/Dockerfile):
#   FORTUNA_CORE_HOST      Core Service FQDN (the Helm chart and deploy/ set it)
#   NGINX_LOCAL_RESOLVERS  nameservers from /etc/resolv.conf (cluster DNS)
# Log $uri (no query string): browser WebSocket clients authenticate with
# ?token=<JWT>, which must not be written to access logs.
log_format fortuna_noquery '$remote_addr - $remote_user [$time_local] '
                           '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                           '"$http_referer" "$http_user_agent"';

server {
  listen 80;
  server_name _;
  access_log /var/log/nginx/access.log fortuna_noquery;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  # Agent ingest is served by Core directly (ClusterIP / NodePort), never
  # through the browser-facing dashboard proxy.
  location ^~ /api/v1/agent/ {
    return 404;
  }

  location ~ ^/api/v2/runtime/(events|producers|coverage|source-health)$ {
    return 404;
  }

  location /api/ {
    # Resolve Core at request time so a restarted Core Service is picked up.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $upstream_core ${FORTUNA_CORE_HOST};
    proxy_pass http://$upstream_core:8080;
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    # WebSocket: /api/v1/ws/pod/:uid and /api/v1/ws/risks (auth via ?token=)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $upstream_core;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite (not append): Core trusts this header only from this proxy,
    # so clients must not be able to inject their own X-Forwarded-For values.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
    proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
  }
}
