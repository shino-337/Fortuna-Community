# Example override file for local development
# Copy this to docker-compose.override.yml and customize as needed
# docker-compose.override.yml is automatically loaded by docker-compose

version: '3.8'

services:
  core:
    # Enable hot-reload for development
    volumes:
      - ./core:/app/core:ro
      - ./api:/app/api:ro
    environment:
      LOG_LEVEL: "debug"
      # Enable auto-reload if using air or similar
      # AIR_WORK_DIR: /app/core

  agent:
    # Enable hot-reload for development
    volumes:
      - ./agent:/app/agent:ro
      - ./api:/app/api:ro
    environment:
      LOG_LEVEL: "debug"

  dashboard:
    # Enable hot-reload for development
    volumes:
      - ./dashboard:/app
      - /app/node_modules
    environment:
      NODE_ENV: development

