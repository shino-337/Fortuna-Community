package migrations

import (
	"log"

	"gorm.io/gorm"
)

// Migration038_CleanupOldSchemaColumns removes old columns and indexes that are no longer used
func Migration038_CleanupOldSchemaColumns(db *gorm.DB) error {
	log.Println("[Migration 038] Starting: Cleanup old schema columns and indexes")

	// 1. Cleanup insights table - remove old columns
	log.Println("[Migration 038] Cleaning up insights table...")
	
	oldInsightsColumns := []struct {
		name        string
		dropFKFirst bool
		dropIndexFirst bool
	}{
		{"type", false, true},                    // Replaced by insight_type
		{"affected_resources", false, true},      // Replaced by direct fields (resource_type, resource_name, etc.)
		{"recommended_action", false, false},      // Replaced by recommendation
		{"sbom_id", true, true},                 // Removed (no longer needed) - has FK
		{"cve_match_id", true, true},            // Removed (no longer needed) - has FK
		{"source", false, true},                  // Removed
		{"cvss_score", false, false},              // Replaced by cvss
		{"cvss_vector", false, false},             // Removed
		{"exploit_available", false, true},        // Removed
		{"package_name", false, true},            // Replaced by affected_component
		{"installed_version", false, false},       // Replaced by affected_version
		{"fixed_version", false, false},           // Moved to Insight model (keep for now, but verify)
	}

	for _, col := range oldInsightsColumns {
		var exists bool
		if err := db.Raw(`
			SELECT EXISTS (
				SELECT 1 FROM information_schema.columns 
				WHERE table_schema = 'public'
				AND table_name = 'insights' 
				AND column_name = $1
			)
		`, col.name).Scan(&exists).Error; err == nil && exists {
			log.Printf("[Migration 038] Dropping old column: insights.%s", col.name)
			
			// Drop foreign key constraint first if needed
			if col.dropFKFirst {
				if col.name == "sbom_id" {
					if err := db.Exec(`ALTER TABLE insights DROP CONSTRAINT IF EXISTS insights_sbom_id_fkey`).Error; err != nil {
						log.Printf("[Migration 038] ⚠️  Error dropping FK for insights.%s: %v", col.name, err)
					}
				} else if col.name == "cve_match_id" {
					if err := db.Exec(`ALTER TABLE insights DROP CONSTRAINT IF EXISTS insights_cve_match_id_fkey`).Error; err != nil {
						log.Printf("[Migration 038] ⚠️  Error dropping FK for insights.%s: %v", col.name, err)
					}
				}
			}
			
			// Drop index first if needed
			if col.dropIndexFirst {
				indexName := "idx_insights_" + col.name
				if err := db.Exec(`DROP INDEX IF EXISTS ` + indexName).Error; err != nil {
					log.Printf("[Migration 038] ⚠️  Error dropping index %s: %v", indexName, err)
				}
			}
			
			// Drop column
			if err := db.Exec(`ALTER TABLE insights DROP COLUMN IF EXISTS ` + col.name + ` CASCADE`).Error; err != nil {
				log.Printf("[Migration 038] ⚠️  Error dropping insights.%s: %v", col.name, err)
			} else {
				log.Printf("[Migration 038] ✅ Dropped insights.%s", col.name)
			}
		}
	}

	// 2. Cleanup cve_matches table - remove old columns
	log.Println("[Migration 038] Cleaning up cve_matches table...")
	
	oldCVEMatchColumns := []struct {
		name        string
		dropFKFirst bool
		dropIndexFirst bool
	}{
		{"component_id", true, true},  // Replaced by package_name - has FK and index
		{"matcher", false, false},       // Removed
		{"db_version", false, false},    // Removed
	}

	for _, col := range oldCVEMatchColumns {
		var exists bool
		if err := db.Raw(`
			SELECT EXISTS (
				SELECT 1 FROM information_schema.columns 
				WHERE table_schema = 'public'
				AND table_name = 'cve_matches' 
				AND column_name = $1
			)
		`, col.name).Scan(&exists).Error; err == nil && exists {
			log.Printf("[Migration 038] Dropping old column: cve_matches.%s", col.name)
			
			// Drop foreign key constraint first if needed
			if col.dropFKFirst {
				if col.name == "component_id" {
					if err := db.Exec(`ALTER TABLE cve_matches DROP CONSTRAINT IF EXISTS cve_matches_component_id_fkey CASCADE`).Error; err != nil {
						log.Printf("[Migration 038] ⚠️  Error dropping FK constraint: %v", err)
					}
				}
			}
			
			// Drop index first if needed
			if col.dropIndexFirst {
				indexName := "idx_cve_matches_" + col.name
				if err := db.Exec(`DROP INDEX IF EXISTS ` + indexName + ` CASCADE`).Error; err != nil {
					log.Printf("[Migration 038] ⚠️  Error dropping index %s: %v", indexName, err)
				}
				// Also drop unique indexes that use component_id
				if col.name == "component_id" {
					if err := db.Exec(`DROP INDEX IF EXISTS idx_cve_matches_unique_sbom_component_cve CASCADE`).Error; err != nil {
						log.Printf("[Migration 038] ⚠️  Error dropping unique index: %v", err)
					}
					if err := db.Exec(`DROP INDEX IF EXISTS idx_cve_matches_unique_sbom_component_cve_all CASCADE`).Error; err != nil {
						log.Printf("[Migration 038] ⚠️  Error dropping unique index: %v", err)
					}
				}
			}
			
			// Drop column
			if err := db.Exec(`ALTER TABLE cve_matches DROP COLUMN IF EXISTS ` + col.name + ` CASCADE`).Error; err != nil {
				log.Printf("[Migration 038] ⚠️  Error dropping cve_matches.%s: %v", col.name, err)
			} else {
				log.Printf("[Migration 038] ✅ Dropped cve_matches.%s", col.name)
			}
		}
	}

	// 3. Cleanup duplicate indexes
	log.Println("[Migration 038] Cleaning up duplicate indexes...")
	
	duplicateIndexes := []string{
		"idx_insights_created",           // Duplicate of idx_insights_created_at
		"idx_insights_type",              // Old, replaced by idx_insights_insight_type
		"idx_sboms_image_digest",         // Duplicate of sboms_image_digest_key (unique constraint)
		"idx_insights_affected_resources_gin",           // Old JSONB index
		"idx_insights_cve_match_id",                     // Old column index
		"idx_insights_sbom_id",                          // Old column index
		"idx_insights_package_name",                      // Old column index
		"idx_insights_exploit_available",                 // Old column index
		"idx_insights_source",                            // Old column index
		"idx_insights_vuln_dedup",                        // Old schema based
		"idx_cve_matches_component_id",                   // Old column index
	}

	for _, idx := range duplicateIndexes {
		var exists bool
		if err := db.Raw(`
			SELECT EXISTS (
				SELECT 1 FROM pg_indexes 
				WHERE schemaname = 'public' 
				AND indexname = $1
			)
		`, idx).Scan(&exists).Error; err == nil && exists {
			log.Printf("[Migration 038] Dropping duplicate index: %s", idx)
			if err := db.Exec(`DROP INDEX IF EXISTS ` + idx).Error; err != nil {
				log.Printf("[Migration 038] ⚠️  Error dropping index %s: %v", idx, err)
			} else {
				log.Printf("[Migration 038] ✅ Dropped index %s", idx)
			}
		}
	}

	// 4. Drop old foreign key constraints if they reference dropped columns
	log.Println("[Migration 038] Cleaning up old foreign key constraints...")
	
	oldFKs := []string{
		"insights_cve_match_id_fkey",  // References cve_match_id (dropped)
		"insights_sbom_id_fkey",       // May need to keep, verify
	}

	for _, fk := range oldFKs {
		var exists bool
		if err := db.Raw(`
			SELECT EXISTS (
				SELECT 1 FROM information_schema.table_constraints 
				WHERE constraint_schema = 'public'
				AND constraint_name = $1
			)
		`, fk).Scan(&exists).Error; err == nil && exists {
			log.Printf("[Migration 038] Dropping old FK constraint: %s", fk)
			// Get table name from constraint
			var tableName string
			if err := db.Raw(`
				SELECT table_name 
				FROM information_schema.table_constraints 
				WHERE constraint_schema = 'public'
				AND constraint_name = $1
			`, fk).Scan(&tableName).Error; err == nil && tableName != "" {
				if err := db.Exec(`ALTER TABLE ` + tableName + ` DROP CONSTRAINT IF EXISTS ` + fk).Error; err != nil {
					log.Printf("[Migration 038] ⚠️  Error dropping FK %s: %v", fk, err)
				} else {
					log.Printf("[Migration 038] ✅ Dropped FK %s", fk)
				}
			}
		}
	}

	log.Println("[Migration 038] ✅ Completed successfully")
	return nil
}

